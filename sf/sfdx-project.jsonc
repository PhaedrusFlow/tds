{
    "name": "map-salesforce",
    "namespace": "",
    "packageAliases": {
        "map-base": "0Ho000000000001AAA",
        "map-base@1.0.0-1": "04t000000000001AAA",
        "map-feature": "0Ho000000000002AAA",
        "map-feature@1.0.0-1": "04t000000000002AAA"
    },
    "packageDirectories": [
        {
            "path": "force-app",
            "default": true,
            "package": "map-base",
            "versionName": "ver 1.0",
            "versionNumber": "1.0.0.NEXT",
            "definitionFile": "config/project-scratch-def.json",
            "branch": "main",
            "ancestorId": "",
            "ancestorVersion": "",
            "dependencies": [],
            "includeProfileUserLicenses": false,
            "postInstallScript": "",
            "uninstallScript": "",
            "releaseNotesUrl": "",
            "versionDescription": "Base package",
            "seedMetadata": {
                "path": "seed/base"
            }
        },
        {
            "path": "packages/feature",
            "default": false,
            "package": "map-feature",
            "versionName": "ver 1.0",
            "versionNumber": "1.0.0.NEXT",
            "definitionFile": "config/project-scratch-def.json",
            "branch": "main",
            "ancestorId": "",
            "ancestorVersion": "",
            "dependencies": [
                {
                    "package": "map-base",
                    "versionNumber": "1.0.0.LATEST"
                }
            ],
            "includeProfileUserLicenses": false,
            "postInstallScript": "",
            "uninstallScript": "",
            "releaseNotesUrl": "",
            "versionDescription": "Feature package",
            "seedMetadata": {
                "path": "seed/feature"
            }
        },
        {
            "path": "unpackaged/config",
            "default": false
        }
    ],
    "plugins": {
        "salesforcedx-vscode-core": {
            "enable-sobject-refresh-on-startup": true
        }
    },
    "pushPackageDirectoriesSequentially": false,
    "replacements": [
        {
            "filename": "force-app/main/default/customMetadata/App_Config.Default.md-meta.xml",
            "replace": "API_BASE_URL_PLACEHOLDER",
            "replaceWith": "https://sandbox.my.salesforce.com"
        },
        {
            "filename": "force-app/main/default/namedCredentials/External_API.namedCredential-meta.xml",
            "replace": "ENV_NAME_PLACEHOLDER",
            "replaceWith": "SANDBOX"
        }
    ],
    "sfdcLoginUrl": "https://test.salesforce.com",
    "sourceApiVersion": "67.0",
    "oauthLocalPort": 1718,
    "sourceBehaviorOptions": [
        "decomposeCustomLabelsBeta2",
        "decomposeExternalServiceRegistrationBeta",
        "decomposePermissionSetBeta2",
        "decomposeSharingRulesBeta",
        "decomposeWorkflowBeta"
    ]
}
