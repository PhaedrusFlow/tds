awk '
BEGIN {
  page = 1
  line = 0
}
{
  if ($0 ~ /^--- page /) {
    page++
    line = 0
    print $0
  } else {
    line++
    if (NF == 0) {
      print ""
    } else {
      printf "P%d:L%d %s\n", page, line, $0
    }
  }
}
